{
    "name": "Razor Sharp Canines",
    "description": "You can bite and latch onto the player you are looking at.",
    "badges": [
        {
            "type": "origins:tooltip",
            "text": "4 block minimum distance!",
            "sprite": "origins:textures/gui/badge/active.png"
        }
    ],
    "type": "origins:multiple",
    "bite": {
        "condition": {
            "type": "origins:raycast",
            "distance": 4,
            "block": false,
            "entity": true,
            "shape_type": "outline",
            "fluid_handling": "any"
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:raycast",
                    "distance": 4,
                    "block": false,
                    "entity": true,
                    "shape_type": "outline",
                    "fluid_handling": "any",
                    "bientity_action": {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:execute_command",
                                    "command": "tag @s add msmp_origins.ruffian.new_bite_victim"
                                },
                                {
                                    "type": "origins:delay",
                                    "action": {
                                        "type": "origins:and",
                                        "actions": [
                                            {
                                                "type": "origins:execute_command",
                                                "command": "tag @s remove msmp_origins.ruffian.new_bite_victim"
                                            },
                                            {
                                                "type": "origins:execute_command",
                                                "command": "playsound msmp_origins:ability.ruffian.bite player @a ~ ~ ~ 1 1"
                                            }
                                        ]
                                    },
                                    "ticks": 2
                                }
                            ]
                        }
                    },
                    "hit_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:delay",
                                "action": {
                                    "type": "origins:execute_command",
                                    "command": "execute as @e[tag=msmp_origins.ruffian.new_bite_victim] store result score @s msmp_origins.ruffian.bite_id run data get entity @p UUID[0]"
                                },
                                "ticks": 1
                            }
                        ]
                    }
                }
            ]
        },
        "cooldown": 300,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_03.png",
            "bar_index": 22
        },
        "key": "primary"
    },
    "def": {
        "type": "origins:action_on_callback",
        "entity_action_chosen": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "scoreboard objectives add msmp_origins.ruffian.bite_id dummy"
                },
                {
                    "type": "origins:execute_command",
                    "command": "execute store result score @s msmp_origins.ruffian.bite_id run data get entity @s UUID[0]"
                }
            ]
        },
        "execute_chosen_when_orb": true
    },
    "tick": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "execute as @e[distance=0.1..] if score @s msmp_origins.ruffian.bite_id = @p msmp_origins.ruffian.bite_id run tp @s ^ ^1 ^1"
                },
                {
                    "type": "origins:execute_command",
                    "command": "execute as @e[distance=0.1..] if score @s msmp_origins.ruffian.bite_id = @p msmp_origins.ruffian.bite_id run damage @s 2 minecraft:player_attack by @p"
                }
            ]
        }
    },
    "stop_biting": {
        "type": "origins:resource",
        "min": 0,
        "max": 4,
        "start_value": 0,
        "max_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:set_resource",
                    "resource": "*:*_stop_biting",
                    "value": 0
                },
                {
                    "type": "origins:execute_command",
                    "command": "/execute as @e[distance=0.1..] if score @s msmp_origins.ruffian.bite_id = @p msmp_origins.ruffian.bite_id run scoreboard players reset @s msmp_origins.ruffian.bite_id"
                }
            ]
        }
    },
    "stop_biting_hit": {
        "type": "origins:self_action_when_hit",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_stop_biting",
            "change": 1,
            "operation": "add"
        },
        "cooldown": 0
    }
}