{
    "name": "Good Dog",
    "description": "You get Regeneration and Absorption II, but also Slowness II for 15 seconds. When right clicked by another player while active, you heal 2 hearts and time increases by 5 seconds.",
    "type": "origins:multiple",
    "time": {
        "type": "origins:resource",
        "min": 0,
        "max": 15,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
            "bar_index": 4,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_time",
                "comparison": ">=",
                "compare_to": 1
            }
        },
        "min_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.wolf.pant",
                    "volume": 1,
                    "pitch": 1
                },
                {
                    "type": "origins:execute_command",
                    "command": "tag @s remove msmp_origins.ruffian.good_dog"
                }
            ]
        },
        "max_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.wolf.whine",
                    "volume": 1,
                    "pitch": 1
                },
                {
                    "type": "origins:spawn_particles",
                    "particle": "minecraft:heart",
                    "count": 8,
                    "speed": 0,
                    "spread": {
                        "x": 0.4,
                        "y": 0.4,
                        "z": 0.4
                    }
                }
            ]
        }
    },
    "start": {
        "condition": {
            "inverted": true,
            "type": "origins:resource",
            "resource": "*:*_time",
            "comparison": ">=",
            "compare_to": 1
        },
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "tag @s add msmp_origins.ruffian.good_dog"
                },
                {
                    "type": "origins:set_resource",
                    "resource": "*:*_time",
                    "value": 15
                }
            ]
        },
        "cooldown": 0,
        "key": "secondary"
    },
    "tick": {
        "condition": {
            "type": "origins:resource",
            "resource": "*:*_time",
            "comparison": ">=",
            "compare_to": 1
        },
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_time",
                    "change": -1,
                    "operation": "add"
                },
                {
                    "type": "origins:apply_effect",
                    "effects": [
                        {
                            "effect": "minecraft:regeneration",
                            "duration": 30,
                            "amplifier": 1,
                            "is_ambient": true,
                            "show_particles": false,
                            "show_icon": true
                        },
                        {
                            "effect": "minecraft:absorption",
                            "duration": 30,
                            "amplifier": 1,
                            "is_ambient": true,
                            "show_particles": false,
                            "show_icon": true
                        },
                        {
                            "effect": "minecraft:slowness",
                            "duration": 30,
                            "amplifier": 1,
                            "is_ambient": true,
                            "show_particles": false,
                            "show_icon": true
                        }
                    ]
                }
            ]
        }
    }
}