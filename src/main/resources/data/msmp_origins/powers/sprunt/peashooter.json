{
    "name": "Peashooter!",
    "description": "Shoot a pea to damage entities.",
    "type": "origins:multiple",
    "arrow": {
        "type": "origins:fire_projectile",
        "entity_type": "minecraft:arrow",
        "cooldown": 20,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
            "bar_index": 21
        },
        "count": 1,
        "interval": 0,
        "start_delay": 0,
        "speed": 1.5,
        "divergence": 1,
        "tag": "{crit:1b,Tags:[\"msmp_origins.sprunt.pea\"],Passengers:[{id:\"minecraft:block_display\",billboard:\"center\",Tags:[\"msmp_origins.sprunt.pea_block\"],transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[-0.5f,-1f,-0.5f],scale:[1f,1f,1f]},block_state:{Name:\"minecraft:moss_block\"}}],SoundEvent:\"block.honey_block.place\"}",
        "key": "primary",
        "shooter_action": {
            "type": "origins:play_sound",
            "sound": "minecraft:block.slime_block.break",
            "volume": 1,
            "pitch": 2
        }
    },
    "kill_arrow": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "execute as @e[tag=msmp_origins.sprunt.pea] if data entity @s {inGround:1b} run kill @s"
                },
                {
                    "type": "origins:execute_command",
                    "command": "execute as @e[tag=msmp_origins.sprunt.pea_block] at @s unless entity @e[tag=msmp_origins.sprunt.pea,limit=1,sort=nearest,distance=..5] run kill @s"
                }
            ]
        }
    }
}